# Server-only MegaOTT configuration. Never expose these values to Vite/client code.
MEGAOTT_BEARER_TOKEN=

# MegaOTT package selected for automatic paid provisioning (for example 4 = 1 Month).
# Keep the mapping in the active iptv_providers.metadata.default_package_id when
# products require different packages; do not put a real token in this file.
MEGAOTT_DEFAULT_PACKAGE_ID=

# Must remain false in production. true is only for local deterministic tests.
MEGAOTT_MOCK_MODE=false

# Hard production safety gate. Keep false until an explicit live-provisioning
# authorization is given; mock mode remains available for local tests.
MEGAOTT_REAL_PROVISIONING_ENABLED=false

# Server-only CamerPay configuration. CamerPay sandbox/live keys are distinct.
CAMERPAY_API_KEY=
CAMERPAY_WEBHOOK_SECRET=
CAMERPAY_MODE=production
# Optional; the official API uses https://camerpay.biz by default.
CAMERPAY_BASE_URL=
